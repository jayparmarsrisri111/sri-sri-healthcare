# Sri Sri ❤️ HealthCare - Server Environment Configuration Template
# Copy this file to .env and configure your secrets safely.
# DO NOT COMMIT .env TO VERSION CONTROL!

PORT=5000
NODE_ENV=development

# Python AI Microservice URL (FastAPI)
AI_ENGINE_URL=http://127.0.0.1:8005

# MongoDB Connection String (defaults to local with in-memory offline fallback)
# MONGO_URI=mongodb://localhost:27017/swasthyasetu

# Allowed Origins for CORS (comma-separated, optional)
# ALLOWED_ORIGINS=https://www.srisri111.com,https://srisri111.com

# Optional Cloud AI API Keys
# GEMINI_API_KEY=your_gemini_api_key_here
